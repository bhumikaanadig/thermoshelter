# Backend-only settings; never copy service credentials into VITE_ variables.
FIREBASE_PROJECT_ID=your-project-id
THERMOSHELTER_FIRESTORE_ENABLED=true
# Set in the API process, or use an approved Google Cloud Application Default Credential.
GOOGLE_APPLICATION_CREDENTIALS=C:\path\outside\repository\service-account.json
# Add the Web app's public API key here only when running api/test_firebase_cloud.py.
THERMOSHELTER_FIREBASE_TEST_API_KEY=your-public-web-api-key
THERMOSHELTER_FIREBASE_TEST_ORIGIN=http://localhost:5173/
# Optional, comma-separated deployed frontend origins.
THERMOSHELTER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
